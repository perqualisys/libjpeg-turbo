# @@ (maybe/later): Use Windows resource script (upstream/win/jpeg.rc.in).
#    Looks like mostly version info, product name, copyright, etc.

linux   = ($c.target.class == 'linux')
bsd     = ($c.target.class == 'bsd')
windows = ($c.target.class == 'windows')
msvc    = ($c.class == 'msvc')

# The libjpeg API sources, as upstream's JPEG_SOURCES in CMakeLists.txt, with
# arithmetic coding enabled.
#
# Since 3.0 the data precision dependent sources are compiled once for each
# precision (8, 12 and 16 bits) through the wrappers in src/wrapper/, which
# set BITS_IN_JSAMPLE and include the source from src/.
#
src = jcapimin wrapper/jcapistd-8 wrapper/jcapistd-12 wrapper/jcapistd-16     \
      wrapper/jccoefct-8 wrapper/jccoefct-12                                  \
      wrapper/jccolor-8 wrapper/jccolor-12 wrapper/jccolor-16                 \
      wrapper/jcdctmgr-8 wrapper/jcdctmgr-12                                  \
      wrapper/jcdiffct-8 wrapper/jcdiffct-12 wrapper/jcdiffct-16              \
      jchuff jcicc jcinit jclhuff                                             \
      wrapper/jclossls-8 wrapper/jclossls-12 wrapper/jclossls-16              \
      wrapper/jcmainct-8 wrapper/jcmainct-12 wrapper/jcmainct-16              \
      jcmarker jcmaster jcomapi jcparam jcphuff                               \
      wrapper/jcprepct-8 wrapper/jcprepct-12 wrapper/jcprepct-16              \
      wrapper/jcsample-8 wrapper/jcsample-12 wrapper/jcsample-16              \
      jctrans jdapimin                                                        \
      wrapper/jdapistd-8 wrapper/jdapistd-12 wrapper/jdapistd-16              \
      jdatadst jdatasrc                                                       \
      wrapper/jdcoefct-8 wrapper/jdcoefct-12                                  \
      wrapper/jdcolor-8 wrapper/jdcolor-12 wrapper/jdcolor-16                 \
      wrapper/jddctmgr-8 wrapper/jddctmgr-12                                  \
      wrapper/jddiffct-8 wrapper/jddiffct-12 wrapper/jddiffct-16              \
      jdhuff jdicc jdinput jdlhuff                                            \
      wrapper/jdlossls-8 wrapper/jdlossls-12 wrapper/jdlossls-16              \
      wrapper/jdmainct-8 wrapper/jdmainct-12 wrapper/jdmainct-16              \
      jdmarker jdmaster                                                       \
      wrapper/jdmerge-8 wrapper/jdmerge-12                                    \
      jdphuff                                                                 \
      wrapper/jdpostct-8 wrapper/jdpostct-12 wrapper/jdpostct-16              \
      wrapper/jdsample-8 wrapper/jdsample-12 wrapper/jdsample-16              \
      jdtrans jerror jfdctflt                                                 \
      wrapper/jfdctfst-8 wrapper/jfdctfst-12                                  \
      wrapper/jfdctint-8 wrapper/jfdctint-12                                  \
      wrapper/jidctflt-8 wrapper/jidctflt-12                                  \
      wrapper/jidctfst-8 wrapper/jidctfst-12                                  \
      wrapper/jidctint-8 wrapper/jidctint-12                                  \
      wrapper/jidctred-8 wrapper/jidctred-12                                  \
      jmemmgr jmemnobs jpeg_nbits                                             \
      wrapper/jquant1-8 wrapper/jquant1-12                                    \
      wrapper/jquant2-8 wrapper/jquant2-12                                    \
      wrapper/jutils-8 wrapper/jutils-12 wrapper/jutils-16                    \
      jaricom jcarith jdarith

# The sources that the above include rather than being compiled themselves.
#
inc = jcapistd jccoefct jccolext jccolor jcdctmgr jcdiffct jclossls jcmainct  \
      jcprepct jcsample jdapistd jdcoefct jdcol565 jdcolext jdcolor jddctmgr  \
      jddiffct jdlossls jdmainct jdmerge jdmrg565 jdmrgext jdpostct jdsample  \
      jfdctfst jfdctint jidctflt jidctfst jidctint jidctred jquant1 jquant2   \
      jstdhuff jutils

lib{jpeg}: src/h{* -jconfig -jconfigint -jversion}                           \
           src/h{jconfig jconfigint jversion}                                 \
           src/c{$src}

lib{jpeg}: src/c{$inc}: include = adhoc

# Module definition file (the libjpeg v6b API, which includes the in-memory
# source and destination managers) and Linux/BSD linker version script.
#
lib{jpeg}: win/def{jpeg62}: include = $windows

define vsc: file
vsc{*}: extension = map
libs{jpeg}: src/vsc{libjpeg}: include = ($linux || $bsd ? adhoc : false)

# Generated headers.
#
# See the .in files and CMakeLists.txt for more information about specific
# variables.
#
using autoconf

# Create a numeric version of the package version number. The format is
# <major><minor><patch> where the minor and patch numbers are left-padded with
# zeros to three digits. For example, 3.2.1 becomes 3002001.
#
vp = $version.patch
vm = $version.minor
for i: 0 1
{
  if ($size($vp) < 3)
    vp = "0$vp"
  if ($size($vm) < 3)
    vm = "0$vm"
}
ver_num = "$version.major$vm$vp"

# The library version (note: not the package or upstream project version). Use
# 6.2 because that's the library version used by libjpeg v6b which is the
# API/ABI we're emulating (see README-DEV).
#
libver_major = 6
libver_minor = 2

size_t = ($regex.match($c.target.cpu, 'i[3-6]86|arm|armv[4-7].*|mips|powerpc') \
          ? 4                                                                 \
          : 8)

src/h{jconfig}: src/in{jconfig}
{
  # The JPEG library version ID (used, for example, in feature checks).
  #
  JPEG_LIB_VERSION = $libver_major$libver_minor

  # "Define if your (broken) compiler shifts signed values as if they were
  # unsigned."
  #
  RIGHT_SHIFT_IS_UNSIGNED = false
}

src/h{jconfigint}: src/in{jconfigint}
{
  # Used as part of the libjpeg version string. The upstream default is
  # `%Y%m%d`. Note that upstream always uses it in combination with version
  # so we will make it just the snapshot part (if any).
  #
  BUILD = "$version.snapshot_string"

  # How upstream hides the global symbols that are not part of the API.
  #
  HIDDEN = ($windows ? '' : '__attribute__((visibility("hidden")))')

  # Upstream forces inlining by default (FORCE_INLINE).
  #
  INLINE = ($msvc                                                             \
            ? '__forceinline'                                                 \
            : 'inline __attribute__((always_inline))')

  # This is only used in the implementation of the TurboJPEG API (which we
  # disable).
  #
  THREAD_LOCAL = ($msvc ? '__declspec(thread)' : '__thread')

  # Defines the `PACKAGE_NAME` macro which is embedded inside images by the
  # compressor.
  #
  CMAKE_PROJECT_NAME = $project

  SIZE_T = $size_t

  # "Define if your compiler has __builtin_ctzl() and sizeof(unsigned long) ==
  # sizeof(size_t)."
  #
  HAVE_BUILTIN_CTZL = (!$msvc && !$windows)

  HAVE_INTRIN_H = $msvc

  SIMD_ARCHITECTURE = NONE
  WITH_SIMDE = false

  WITH_PROFILE = false
}

src/h{jversion}: src/in{jversion}
{
  COPYRIGHT_YEAR = '1991-2026'
}

# Common generated header variables.
#
src/h{jconfig} src/h{jconfigint}:
{
  autoconf.flavor = cmake

  # The project version number.
  #
  VERSION = "$version.major.$version.minor.$version.patch"

  LIBJPEG_TURBO_VERSION_NUMBER = $ver_num

  # WITH_ARITH_DEC and WITH_ARITH_ENC are defined by default in the upstream
  # build (which causes the variables below to be defined to 1); see
  # BUILDING.md, section `Arithmetic Coding Support` for details.
  #
  # Note: If these are ever disabled, remove c{jaricom jcarith jdarith} from
  #       the build.
  #
  C_ARITH_CODING_SUPPORTED = true
  D_ARITH_CODING_SUPPORTED = true

  WITH_SIMD = false
}

# Linker version script.
#
src/vsc{libjpeg}: src/in{libjpeg}
{
  # The library version number.
  #
  JPEG_LIB_VERSION_DECIMAL = $libver_major.$libver_minor

  # Functions exported by name (upstream's MEM_SRCDST_FUNCTIONS).
  #
  MEM_SRCDST_FUNCTIONS = 'global:  jpeg_mem_dest;  jpeg_mem_src;'
}

# Build options.
#
c.poptions =+ "-I$out_base/src" "-I$src_base/src"

if $msvc
  c.poptions += -D_CRT_SECURE_NO_DEPRECATE -D_CRT_NONSTDC_NO_WARNINGS
elif ($linux || $bsd)
  c.loptions += "-Wl,--version-script=$out_base/src/libjpeg.map"

# Export options.
#
lib{jpeg}: c.export.poptions = "-I$out_base/src" "-I$src_base/src"

# For pre-releases use the complete version to make sure they cannot be used
# in place of another pre-release or the final version. See the version module
# for details on the version.* variable values.
#
if $version.pre_release
  lib{jpeg}: bin.lib.version = "-$version.project_id"
else
  lib{jpeg}: bin.lib.version = "-$version.major.$version.minor"

# Install public headers directly into, say, /usr/include/.
#
src/h{*}: install = false
src/h{jconfig}: install = include/
src/h{jerror}@./src/ src/h{jmorecfg}@./src/ src/h{jpeglib}@./src/:            \
  install = include/
