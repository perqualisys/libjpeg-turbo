# Build the SIMD extensions where this package supports them (currently
# x86-64, which requires NASM).
#
config [bool] config.libjpeg_turbo.simd ?= true

# Uncomment to suppress warnings coming from external libraries.
#
#c.internal.scope = current

using in

using c

h{*}: extension = h
c{*}: extension = c

# The test target for cross-testing (running tests under Wine, etc).
#
test.target = $c.target
